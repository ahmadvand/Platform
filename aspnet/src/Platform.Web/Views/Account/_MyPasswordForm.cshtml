@model Platform.Web.Domain.User
@* فاز ۵۲ — تغییر رمز عبور «خودِ کاربر جاری»: پاپ‌آپ AJAX از منوی کاربرِ نوار بالایی.
   همان سیاست رمز و کنترل ۳ رمز اخیر بازنشانی مدیر؛ رمز فعلی برای تأیید هویت الزامی است. *@
<div data-modal-title="@HrT.F("تغییر رمز عبور — {0}", Model.Username)" hidden></div>
<form method="post" action="/Account/ChangePassword" data-ajax>
    @Html.AntiForgeryToken()
    <div class="fld">
        <label>@HrT.T("رمز عبور فعلی") *</label>
        <input type="password" name="currentPassword" autocomplete="current-password" required />
    </div>
    <div class="fld">
        <label>@HrT.T("رمز عبور جدید") *</label>
        <input type="password" name="newPassword" autocomplete="new-password" required />
    </div>
    <div class="fld">
        <label>@HrT.T("تکرار رمز عبور جدید") *</label>
        <input type="password" name="newPassword2" autocomplete="new-password" required />
    </div>
    <div class="hint">@HrT.T("حداقل ۸ کاراکتر شامل حرف و عدد و حروف بزرگ/کوچک — رمز جدید نباید با رمز فعلی یا ۳ رمز اخیر یکسان باشد")</div>
    <div style="display:flex;gap:8px;margin-top:12px">
        <button class="btn btn-primary">🔑 @HrT.T("تغییر رمز عبور")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
