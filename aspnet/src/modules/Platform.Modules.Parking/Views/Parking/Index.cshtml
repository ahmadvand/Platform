</div>

@section Scripts {
<script>
(function () {
        // برچسب‌های چندزبانه — ترجمه سمت سرور در زمان رندر
        var MSG_CONF = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("اطمینان")))';
        var MSG_INACTIVE = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("غیرفعال")))';
        var MSG_ONLINE = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("🟢 آنلاین")))';
        var MSG_OFFLINE = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("🔴 آفلاین")))';
        var MSG_DIR_IN = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("⬅ ورود")))';
        var MSG_DIR_OUT = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("➡ خروج")))';
        var MSG_ENTER = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("ورود")))';
        var MSG_NO_EVENTS = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("هنوز رویدادی ثبت نشده است")))';
        var MSG_NO_INSIDE = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("خودرویی داخل پارکینگ نیست")))';
        var MSG_VEHICLES = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(HrT.T("خودرو")))';
        // فقط در تب «نمای زنده» — این section در همه تب‌های پارکینگ رندر می‌شود
        if (!document.getElementById('ticker')) return;
        function faNum(n) { return Number(n).toLocaleString('fa-IR'); }
        var knownEv = null;   // شناسه‌های رویداد دیده‌شده — اولین poll مبناست (بدون فلش)
        var knownCam = {};    // آخرین پلاک هر دوربین برای فلش خوانش تازه

        function plateChip(text, mini) {
            // فاز ۴۵ — کامپوننت پلاک واقعی (هم‌قرارداد با PlateFmt سرور)؛ بدون به‌هم‌ریختگی bidi
            var host = document.createElement('span');
            if (window.plateHtml) host.innerHTML = window.plateHtml(text, mini);
            else host.textContent = text || '—';
            return host.firstElementChild || host;
        }

        function dirBadge(dir, result) {
            var b = document.createElement('span');
            b.className = 'dir-badge ' + (dir === 'ورود' ? 'in' : 'out');
            b.textContent = (dir === 'ورود' ? '⬅ ' : '➡ ') + dir;
            return b;
        }

        function tickRow(e, flash) {
            var row = document.createElement('div');
            row.className = 'tick-row ' + (e.result === 'مجاز' ? 'ok' : 'err') + (flash ? ' flash' : '');
            row.dataset.ev = e.id;
            row.appendChild(plateChip(e.plate, true));
            var body = document.createElement('div');
            body.className = 'tick-body';
            var l1 = document.createElement('div'); l1.className = 'tick-l1';
            var nm = document.createElement('b'); nm.textContent = e.owner;
            l1.appendChild(nm); l1.appendChild(dirBadge(e.dir));
            var l2 = document.createElement('div'); l2.className = 'tick-l2';
            l2.textContent = (e.gate || '—') + ' · ' + (e.lot || '—') + (e.cam ? ' · 📷 ' + e.cam : ' · ' + (e.method || '')) +
                (e.conf ? ' · ' + MSG_CONF + ' ' + faNum(e.conf) + '٪' : '') + (e.result === 'مجاز' ? '' : ' · ' + e.result);
            body.appendChild(l1); body.appendChild(l2);
            row.appendChild(body);
            var t = document.createElement('span'); t.className = 'tick-time'; t.textContent = e.time || '';
            row.appendChild(t);
            return row;
        }

        function paintCam(dv) {
            var tile = document.querySelector('[data-cam-id="' + dv.id + '"]');
            if (!tile) return;
            var badge = tile.querySelector('[data-role="cam-badge"]');
            if (badge) {
                if (!dv.active) { badge.className = 'badge badge-mute'; badge.textContent = MSG_INACTIVE; }
                else if (dv.online) { badge.className = 'badge badge-ok'; badge.textContent = MSG_ONLINE; }
                else { badge.className = 'badge badge-err'; badge.textContent = MSG_OFFLINE; }
            }
            var feed = tile.querySelector('[data-role="cam-feed"]');
            if (feed) feed.className = 'cam-feed' + (dv.online ? ' on' : '');
            var off = tile.querySelector('[data-role="cam-off"]');
            if (off) off.style.display = dv.online ? 'none' : '';
            var ls = tile.querySelector('[data-role="cam-lastseen"]');
            if (ls) ls.textContent = dv.lastSeen || '—';
            var pl = tile.querySelector('[data-role="cam-plate"]');
            var meta = tile.querySelector('[data-role="cam-readmeta"]');
            if (dv.last && pl && meta) {
                pl.innerHTML = window.plateHtml ? window.plateHtml(dv.last.plate) : (dv.last.plate || '—');
                pl.classList.remove('hot');
                if (knownCam[dv.id] && knownCam[dv.id] !== dv.last.plate + '|' + dv.last.time) {
                    var pr = pl.querySelector('.plate-real') || pl;
                    pr.classList.add('hot');
                    var feedEl = tile.querySelector('[data-role="cam-feed"]');
                    if (feedEl) { feedEl.classList.remove('pulse'); void feedEl.offsetWidth; feedEl.classList.add('pulse'); }
                }
                knownCam[dv.id] = dv.last.plate + '|' + dv.last.time;
                meta.textContent = (dv.last.dir === 'ورود' ? MSG_DIR_IN : MSG_DIR_OUT) +
                    (dv.last.conf ? ' · ' + MSG_CONF + ' ' + faNum(dv.last.conf) + '٪' : '') +
                    (dv.last.result === 'مجاز' ? '' : ' · ' + dv.last.result) + ' — ' + dv.last.owner;
            }
        }

        function paint(j) {
            var k = j.kpis || {};
            function setV(id, v) { var el = document.getElementById(id); if (el) el.innerHTML = v; }
            setV('lv-inside', faNum(k.inside || 0));
            setV('lv-cap', faNum(k.cap || 0));
            setV('lv-today', faNum(k.today || 0));
            setV('lv-auto', faNum(k.autoReads || 0));
            setV('lv-online', faNum(k.online || 0) + '<span style="font-size:12px;color:var(--ink-2)"> / ' + faNum(k.cams || 0) + '</span>');

            (j.cameras || []).forEach(paintCam);

            var tk = document.getElementById('ticker');
            if (tk) {
                var evs = j.events || [];
                if (knownEv === null) knownEv = {};
                var seenNow = {};
                tk.textContent = '';
                if (!evs.length) tk.innerHTML = '<div class="empty">' + MSG_NO_EVENTS + '</div>';
                evs.forEach(function (e) {
                    seenNow[e.id] = 1;
                    tk.appendChild(tickRow(e, !knownEv[e.id] && Object.keys(knownEv).length > 0));
                });
                knownEv = seenNow;
            }

            var il = document.getElementById('insideList');
            if (il) {
                var ins = j.inside || [];
                il.textContent = '';
                if (!ins.length) il.innerHTML = '<div class="empty">' + MSG_NO_INSIDE + '</div>';
                ins.forEach(function (v) {
                    var row = document.createElement('div');
                    row.className = 'tick-row ok';
                    row.appendChild(plateChip(v.plate, true));
                    var body = document.createElement('div'); body.className = 'tick-body';
                    var l1 = document.createElement('div'); l1.className = 'tick-l1';
                    var nm = document.createElement('b'); nm.textContent = v.owner;
                    l1.appendChild(nm);
                    var l2 = document.createElement('div'); l2.className = 'tick-l2';
                    l2.textContent = '🅿️ ' + (v.lot || '—') + ' · ' + MSG_ENTER + ' ' + (v.since || '—');
                    body.appendChild(l1); body.appendChild(l2);
                    row.appendChild(body);
                    il.appendChild(row);
                });
            }
            var ic = document.getElementById('inside-count');
            if (ic) ic.textContent = faNum(k.inside || 0) + ' ' + MSG_VEHICLES;
        }
        liveCommands({ url: '/Parking/LiveData', intervalSec: 6, apply: paint });
})();
</script>
}
