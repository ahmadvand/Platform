<Project>
  <!--
       فاز ۸۵ — OWASP Top 10:2025 (A03: Software Supply Chain Failures)
       پین کردن نسخهٔ امنِ بسته‌های ترانزیتیو آسیب‌پذیر برای همهٔ پروژه‌های پلتفرم زیر src/
       (نتیجهٔ اسکن dotnet list package):
         • SQLitePCLRaw.lib.e_sqlite3 2.1.6  به 2.1.14  (GHSA-2m69-gcr7-jv3q — High)
         • System.Security.Cryptography.Pkcs 8.0.1 به 8.0.2 (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7)
         • System.Security.Cryptography.Xml  8.0.2 به 8.0.5 (دستهٔ ۱۳ advisory GHSA — High)
       ارجاع مستقیم، نسخهٔ ترانزیتیو را در همهٔ پروژه‌ها بالاتر می‌بَرد (رفتار سازگار؛
       فقط وصلهٔ امنیتی کتابخانهٔ زیرین؛ هیچ API عوض نمی‌شود).
       پروژه‌های بیرون از src/ (ابزارهای استودیو) را شامل نمی‌شود.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>
</Project>
