@{
    // فاز ۱۳۲ (مورد ۱۰ ROADMAP-ADDITIONS) — حکم جدید
}
<div data-modal-title="@HrT.T("حکم جدید")" hidden></div>
<form method="post" action="/Contracts/CreateDecree" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("پرسنل *")</label>
            <div class="emp-picker" data-name="employeeId" data-min="1"
                 data-ph="@HrT.T("جستجوی نام یا کد پرسنلی…")" data-empty="@HrT.T("موردی یافت نشد")"></div>
        </div>
        <div class="fld"><label>@HrT.T("نوع حکم")</label>
            <select name="type">
                @foreach (var t in new[] { "استخدام", "ترفیع", "انتقال", "تعلیق", "بازگشت", "اصلاحیه" })
                {
                    <option value="@t">@HrT.T(t)</option>
                }
            </select>
        </div>
        <div class="fld"><label>@HrT.T("شماره حکم *")</label><input name="decreeNo" required placeholder="H-1404-017" /></div>
        <div class="fld"><label>@HrT.T("تاریخ ابلاغ *")</label><input name="date" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld fld-full"><label>@HrT.T("متن / شرح حکم")</label><textarea name="content" rows="3"></textarea></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ثبت حکم")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
