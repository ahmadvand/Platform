@{
    // فاز ۱۳۲ (مورد ۱۰ ROADMAP-ADDITIONS) — قرارداد جدید
}
<div data-modal-title="@HrT.T("قرارداد جدید")" hidden></div>
<form method="post" action="/Contracts/CreateContract" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("پرسنل *")</label>
            <div class="emp-picker" data-name="employeeId" data-min="1"
                 data-ph="@HrT.T("جستجوی نام یا کد پرسنلی…")" data-empty="@HrT.T("موردی یافت نشد")"></div>
        </div>
        <div class="fld"><label>@HrT.T("نوع قرارداد")</label>
            <select name="type">
                @foreach (var t in new[] { "دائم", "موقت", "پروژه‌ای", "آزمایشی" })
                {
                    <option value="@t">@HrT.T(t)</option>
                }
            </select>
        </div>
        <div class="fld"><label>@HrT.T("شماره قرارداد *")</label><input name="contractNo" required placeholder="CH-1404-001" /></div>
        <div class="fld"><label>@HrT.T("از تاریخ *")</label><input name="startDate" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld"><label>@HrT.T("تا تاریخ (خالی = نامحدود)")</label><input name="endDate" type="date" /></div>
        <div class="fld"><label>@HrT.T("حقوق پایه")</label><input name="salary" type="number" step="100000" value="0" /></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ثبت قرارداد")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
