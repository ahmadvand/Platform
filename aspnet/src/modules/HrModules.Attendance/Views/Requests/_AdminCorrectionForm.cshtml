@{
    // فاز ۱۳۲ (مورد ۱۱ ROADMAP-ADDITIONS) — ثبت اصلاحیهٔ تردد از سمت مدیر
    // (تا امروز اصلاحیه فقط از سمت پرسنل در پرتال من ساخته می‌شد؛ سرپرست نمی‌توانست
    //  به‌جای پرسنلی که دستگاه را فراموش کرده، اصلاحیه وارد کند)
}
<div data-modal-title="@HrT.T("اصلاحیهٔ تردد از سمت مدیر")" hidden></div>
<form method="post" action="/Requests/CreateAdminCorrection" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("پرسنل *")</label>
            <div class="emp-picker" data-name="employeeId" data-min="1"
                 data-ph="@HrT.T("جستجوی نام یا کد پرسنلی…")" data-empty="@HrT.T("موردی یافت نشد")"></div>
        </div>
        <div class="fld"><label>@HrT.T("تاریخ *")</label><input name="date" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld"><label>@HrT.T("ورود اصلاحی")</label><input name="requestedIn" type="time" placeholder="08:12" /></div>
        <div class="fld"><label>@HrT.T("خروج اصلاحی")</label><input name="requestedOut" type="time" placeholder="17:05" /></div>
        <div class="fld fld-full"><label>@HrT.T("دلیل *")</label><input name="reason" required placeholder="@HrT.T("مثلاً فراموشی پانچ خروج — تأیید سرپرست")" /></div>
    </div>
    <p class="hint">@HrT.T("پس از ثبت، اصلاحیه در همین صفحه «در انتظار تأیید» می‌ماند؛ تأیید نهایی، رکورد واقعی تردد را با موتور محاسبه بازنویسی می‌کند. حداقل یکی از ورود/خروج اصلاحی الزامی است.")</p>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ثبت اصلاحیه")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
