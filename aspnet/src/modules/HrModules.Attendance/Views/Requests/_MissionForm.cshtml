@{
    // فاز ۱۱۴ — انتخاب پرسنل با جستجوی زندهٔ سرور (emp-picker) — مقیاس ده‌ها هزار نفر
}
<div data-modal-title="@HrT.T("درخواست مأموریت جدید")" hidden></div>
<form method="post" action="/Requests/CreateMission" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("پرسنل *")</label>
            <div class="emp-picker" data-name="employeeId" data-min="1"
                 data-ph="@HrT.T("جستجوی نام یا کد پرسنلی…")" data-empty="@HrT.T("موردی یافت نشد")"></div>
        </div>
        <div class="fld"><label>@HrT.T("نوع")</label>
            <select name="type"><option value="داخلی">@HrT.T("داخلی")</option><option value="خارجی">@HrT.T("خارجی")</option></select>
        </div>
        <div class="fld"><label>@HrT.T("مقصد *")</label><input name="destination" required /></div>
        <div class="fld"><label>@HrT.T("از تاریخ *")</label><input name="fromDate" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld"><label>@HrT.T("تا تاریخ *")</label><input name="toDate" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld fld-full"><label>@HrT.T("هدف مأموریت")</label><input name="purpose" /></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ثبت درخواست")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
