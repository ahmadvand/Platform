@{
    var vehicles = (List<Vehicle>)ViewBag.Vehicles;
    var lots = (List<ParkingLot>)ViewBag.Lots;
}
<div data-modal-title="@HrT.T("صدور مجوز پارکینگ")" hidden></div>
<form method="post" action="/Parking/CreatePermit" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("خودرو *")</label>
            <select name="vehicleId" required>
                @foreach (var v in vehicles)
                {
                    <option value="@v.Id">@v.PlateNo — @(v.Employee?.FullName ?? "—") @(v.Company != null ? "(" + v.Company.Code + ")" : "")</option>
                }
            </select>
        </div>
        <div class="fld"><label>@HrT.T("پارکینگ *")</label>
            <select name="lotId" required>
                @foreach (var l in lots)
                {
                    <option value="@l.Id">@l.Name @(l.Company != null ? "— " + l.Company.Code : "")</option>
                }
            </select>
        </div>
        <div class="fld"><label>@HrT.T("نوع مجوز")</label>
            <select name="type"><option value="دائم">@HrT.T("دائم")</option><option value="موقت">@HrT.T("موقت")</option></select>
        </div>
        <div class="fld"><label>@HrT.T("جایگاه اختصاصی (خالی = پارک آزاد)")</label><input name="spotNo" placeholder="A-12" /></div>
        <div class="fld"><label>@HrT.T("از تاریخ *")</label><input name="validFrom" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld"><label>@HrT.T("تا تاریخ (خالی = بدون انقضا)")</label><input name="validUntil" type="date" /></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("صدور مجوز")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
