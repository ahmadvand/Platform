@{
    Layout = "_Layout";
    ViewData["Title"] = HrT.T("دسترسی غیرمجاز");
}
<div class="card" style="max-width:560px;margin:60px auto;text-align:center">
    <div class="card-b" style="padding:40px">
        <div style="font-size:40px;margin-bottom:10px">⛔</div>
        <h2 style="margin-bottom:8px">@HrT.T("دسترسی غیرمجاز")</h2>
        <p style="color:var(--ink-2);font-size:13px;line-height:2">
            @if (ViewBag.Perm is string p)
            {
                <span>@HrT.T("برای مشاهده این بخش به مجوز") <span class="badge badge-info">@p</span> @HrT.T("برای مشاهدهٔ این بخش.")</span>
            }
            else
            {
                <span>@HrT.T("شما به این بخش دسترسی ندارید. با مدیر سیستم تماس بگیرید.")</span>
            }
        </p>
        <a href="/" class="btn btn-primary" style="margin-top:16px">@HrT.T("بازگشت به داشبورد")</a>
    </div>
</div>
