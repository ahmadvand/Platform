<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ============================================================
    HrModules.Attendance (فاز ۵۸) — ماژول حضور و غیاب، پروژهٔ جدا
    ============
    کنترلرها (تردد روزانه، شیفت‌ها و نوبت‌کاری، درخواست‌ها) و همهٔ ویوها
    در همین اسمبلی کامپایل می‌شوند.

    بستهٔ مشتری بدون این ماژول:
      dotnet publish -p:HrModuleAttendance=false
    در این حالت DLL ماژول از خروجی حذف می‌شود (نه فقط خاموش — «نصب نیست»).

    متعهد به: Platform.Core (پلتفرم مشترک) — وابستگی یک‌طرفه.
    موتور محاسبهٔ کارکرد (AttEngine) در پلتفرم مشترک است چون حقوق و
    گزارش‌ها و DevicesOps هم از آن استفاده می‌کنند.
    ============================================================
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>fa</NeutralLanguage>
    <!-- پشتیبانی صریح Razor برای MVC — بدون این، ویوها در اسمبلی کامپایل نمی‌شوند -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- فاز ۶۱ — لایهٔ دیتای ماژول در پروژهٔ جدا (HrModules.X.Data) کامپایل می‌شود؛
         این پروژه فقط کنترلر/ویو/سرویس است تا نوع‌ها دوبار تعریف نشوند (CS0433) -->
    <Compile Remove="Data\**" />
    <None Remove="Data\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\Platform.Core.csproj" />
    <!-- فاز ۶۸ — پرتال من (SelfAttController) به MvcBase/سرویس‌های هاست نیاز دارد — جهت وابستگی یک‌طرفه باقی می‌ماند: هاست هرگز به ماژول ارجاع ندارد -->
    <ProjectReference Include="..\..\Platform.Web\Platform.Web.csproj" />
    <ProjectReference Include="Data\HrModules.Attendance.Data.csproj" />
  </ItemGroup>

</Project>
