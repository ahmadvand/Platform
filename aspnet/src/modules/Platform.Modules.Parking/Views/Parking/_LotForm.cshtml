@{
    var companies = (List<Company>)ViewBag.Companies;
}
<div data-modal-title="@HrT.T("پارکینگ جدید")" hidden></div>
<form method="post" action="/Parking/CreateLot" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("نام پارکینگ *")</label><input name="name" required placeholder="@HrT.T("پارکینگ اصلی ورودی")" /></div>
        <div class="fld"><label>@HrT.T("کد *")</label><input name="code" required placeholder="PK-XX" /></div>
        <div class="fld"><label>@HrT.T("شرکت مالک *")</label>
            <select name="companyId" required>
                @foreach (var c in companies)
                {
                    <option value="@c.Id">@c.Name (@c.Code)</option>
                }
            </select>
        </div>
        <div class="fld"><label>@HrT.T("ظرفیت (جایگاه) *")</label><input name="capacity" type="number" min="1" value="50" required /></div>
        <div class="fld"><label>@HrT.F("حق پارکینگ ماهانه ({0} — ۰ = رایگان)", Money.CurTitle())</label><input name="monthlyFee" type="number" min="0" step="1000" value="0" /></div>
        <div class="fld"><label>@HrT.T("موقعیت")</label><input name="location" placeholder="@HrT.T("جنب ورودی اصلی، سطح همکف")" /></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ایجاد پارکینگ")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
