@{
    ViewData["Title"] = ViewBag.IsEdit is true ? HrT.T("ویرایش دستگاه") : HrT.T("تعریف دستگاه جدید");
    var d = (Device)Model;
    var isEdit = ViewBag.IsEdit is true;
    // حالت پاپ‌آپ (partial=1): فقط خود فرم — بدون کادر و بدون دکمه بازگشت (فاز ۴۲)
    var isPartial = Context.Request.Query["partial"].ToString() == "1";
}
@if (isPartial)
{
    <partial name="_DeviceForm" model="Model" />
}
else
{
    <div class="card" style="max-width:1000px;margin-inline:auto">
        <div class="card-h">
            <h2>@(isEdit ? HrT.F("ویرایش دستگاه — {0}", d.Name) : HrT.T("تعریف دستگاه جدید"))</h2>
            <a class="btn" href="/Devices">← @HrT.T("بازگشت به دستگاه‌ها")</a>
        </div>
        <partial name="_DeviceForm" model="Model" />
    </div>
}
