generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Core HR (HR-01, HR-02) ============

model Company {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  employees   Employee[]
}

model Department {
  id         String       @id @default(cuid())
  name       String
  code       String       @unique
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id])
  parentId   String?
  parent     Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children   Department[] @relation("DeptTree")
  positions  Position[]
  employees  Employee[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Position {
  id           String     @id @default(cuid())
  title        String
  code         String     @unique
  grade        String? // گروه شغلی
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Employee {
  id             String    @id @default(cuid())
  personnelCode  String    @unique
  firstName      String
  lastName       String
  nationalId     String    @unique
  birthDate      String?
  phone          String?
  email          String?
  employmentType String // رسمی | قراردادی | پیمانکاری | اقماری | کارآموز
  status         String    @default("فعال") // فعال | غیرفعال | تسویه‌شده
  hireDate       DateTime
  endDate        DateTime?
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  positionId     String?
  position       Position?   @relation(fields: [positionId], references: [id])
  baseSalary     Float     @default(0)
  shiftId        String?
  shift          Shift?    @relation(fields: [shiftId], references: [id])
  annualLeaveEnt Float     @default(26)
  annualLeaveUsed Float    @default(0)
  sickLeaveEnt   Float     @default(2)
  sickLeaveUsed  Float     @default(0)
  contracts      Contract[]
  decrees        Decree[]
  attendance     AttendanceRecord[]
  leaves         LeaveRequest[]
  missions       Mission[]
  permits        OvertimePermit[]
  accessPerms    AccessPermission[]
  accessEvents   AccessEvent[]
  corrections    CorrectionRequest[]
  payslips       Payslip[]
  user           User?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Contract {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  type       String // دائم | موقت | پروژه‌ای | آزمایشی
  contractNo String    @unique
  startDate  DateTime
  endDate    DateTime?
  salary     Float     @default(0)
  status     String    @default("فعال") // فعال | منقضی | فسخ‌شده
  createdAt  DateTime  @default(now())
}

model Decree {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String // استخدام | ترفیع | انتقال | تعلیق | بازگشت | اصلاحیه
  decreeNo     String
  date         DateTime
  content      String?
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ============ Shifts & Attendance (ATT-01..07) ============

model Shift {
  id             String  @id @default(cuid())
  name           String
  type           String // عادی | نوبت‌کاری | چرخشی | ۱۲ساعته | اقماری
  startTime      String // "08:00"
  endTime        String // "16:00"
  breakMinutes   Int     @default(60)
  cyclePattern   String? // ۱۴/۱۴ | ۲۱/۷ | ۲۸/۲۸ for اقماری
  toleranceLate  Int     @default(10) // دقیقه مجاز تأخیر
  active         Boolean @default(true)
  employees      Employee[]
  createdAt      DateTime @default(now())
}

model Device {
  id              String  @id @default(cuid())
  name            String
  brand           String // ZKTeco | Suprema | Anviz | Virdi | Timmy
  serial          String  @unique
  ip              String?
  location        String?
  purpose         String // حضور و غیاب | کنترل تردد
  mode            String  @default("آنلاین") // آنلاین | آفلاین
  lastSync        DateTime?
  active          Boolean @default(true)
  webhookToken    String  @unique @default(cuid()) // auto-provisioned secret for ADMS/bridge auth
  pollingInterval Int     @default(60) // ثانیه
  lastSeenAt      DateTime?
  lastPulledAt    DateTime?
  firmware        String?
  userCount       Int?
  attendanceRecords AttendanceRecord[]
  commands        DeviceCommand[]
  gates           Gate[]
  createdAt       DateTime @default(now())
}

model AttendanceRecord {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  deviceId        String?
  device          Device?   @relation(fields: [deviceId], references: [id])
  date            String // "2026-10-18"
  checkIn         DateTime?
  checkOut        DateTime?
  workMinutes     Int       @default(0)
  lateMinutes     Int       @default(0)
  earlyMinutes    Int       @default(0)
  overtimeMinutes Int       @default(0)
  status          String // حاضر | غایب | مرخصی | مأموریت | تعطیل
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // استحقاقی | استعلاجی | بدون‌حقوق | ساعتی | زایمان
  fromDate   String
  toDate     String
  days       Float    @default(1)
  hours      Int?
  reason     String?
  status     String   @default("در انتظار تأیید") // در انتظار تأیید | تأیید شده | رد شده
  approver   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Mission {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String // داخلی | خارجی
  destination String
  purpose     String?
  fromDate    String
  toDate      String
  status      String   @default("در انتظار تأیید")
  approver    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OvertimePermit {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // اضافه‌کاری | کار در تعطیل | خروج غیرمجاز
  date       String
  fromTime   String
  toTime     String
  reason     String?
  status     String   @default("در انتظار تأیید")
  approver   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ Access Control (AC-01..07) ============

model Zone {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  riskLevel   String  @default("عادی") // عادی | حساس | فوق‌حساس
  description String?
  gates       Gate[]
  accessPerms AccessPermission[]
  createdAt   DateTime @default(now())
}

model Gate {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  zoneId       String
  zone         Zone    @relation(fields: [zoneId], references: [id])
  deviceId     String?
  device       Device? @relation(fields: [deviceId], references: [id])
  type         String // گیت میله‌ای | راهبند | درب برقی | ورودی‌گردان
  direction    String  @default("دوطرفه") // ورودی | خروجی | دوطرفه
  status       String  @default("فعال") // فعال | غیرفعال | خراب
  accessEvents AccessEvent[]
  createdAt    DateTime @default(now())
}

model AccessPermission {
  id         String    @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  visitorId  String?
  visitor    Visitor?  @relation("VisitorPerms", fields: [visitorId], references: [id])
  zoneId     String
  zone       Zone      @relation(fields: [zoneId], references: [id])
  type       String    @default("دائم") // دائم | موقت
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  days       String? // "شنبه,یکشنبه,..." or "1-5"
  timeFrom   String?
  timeUntil  String?
  status     String    @default("فعال") // فعال | منقضی | لغوشده
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AccessEvent {
  id         String   @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  visitorId  String?
  visitor    Visitor?  @relation("VisitorEvents", fields: [visitorId], references: [id])
  gateId     String
  gate       Gate     @relation(fields: [gateId], references: [id])
  direction  String // ورود | خروج
  method     String   @default("کارت") // کارت | اثر انگشت | چهره | QR | RFID
  result     String   @default("مجاز") // مجاز | غیرمجاز
  reason     String?
  timestamp  DateTime @default(now())
}

// ============ Visitors & Security (VIS-01..08) ============

model Contractor {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  contactName String?
  phone       String?
  contractNo  String?
  validUntil  DateTime?
  active      Boolean   @default(true)
  visitors    Visitor[]
  createdAt   DateTime  @default(now())
}

model Visitor {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  nationalId   String
  phone        String?
  idDocType    String    @default("کارت ملی") // کارت ملی | گواهینامه | شناسنامه | پاسپورت
  type         String    @default("مهمان") // مهمان | مراجع | پیمانکار
  hostName     String
  hostDept     String?
  purpose      String
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  status       String    @default("در انتظار تأیید") // در انتظار تأیید | تأیید شده | داخل سازمان | خارج شده | رد شده
  approvedBy   String?
  requestedAt  DateTime  @default(now())
  card         VisitorCard?
  logs         VisitLog[]
  accessEvents AccessEvent[] @relation("VisitorEvents")
  accessPerms  AccessPermission[] @relation("VisitorPerms")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model VisitorCard {
  id         String   @id @default(cuid())
  cardNo     String   @unique
  type       String   @default("QR") // QR | بارکد | RFID
  visitorId  String   @unique
  visitor    Visitor  @relation(fields: [visitorId], references: [id])
  issuedAt   DateTime @default(now())
  validUntil DateTime
  returned   Boolean  @default(false)
}

model VisitLog {
  id        String   @id @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  direction String // ورود | خروج
  gateName  String?
  timestamp DateTime @default(now())
}

model SecurityAlert {
  id        String   @id @default(cuid())
  type      String // ورود غیرمجاز | تأخیر خروج | کارت گمشده | مجوز منقضی | بیش‌ماندن مهمان
  severity  String   @default("متوسط") // بحرانی | بالا | متوسط | پایین
  message   String
  source    String   @default("کنترل تردد") // کنترل تردد | ارباب رجوع | حضور و غیاب
  refId     String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Auth & RBAC (PLAN Phase 0 / 1) ============

model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  passwordHash        String
  fullName            String
  employeeId          String?  @unique
  employee            Employee? @relation(fields: [employeeId], references: [id])
  isActive            Boolean  @default(true)
  isSuperadmin        Boolean  @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime @default(now())
  passwordExpiresAt   DateTime?
  mustChangePassword  Boolean  @default(false)
  lastLoginAt         DateTime?
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordHistory     PasswordHistory[]
  passwordResets      PasswordReset[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // superadmin | hr_manager | att_operator | security | device_agent | viewer
  title       String
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
}

model Permission {
  id    Int    @id @default(autoincrement())
  key   String @unique // employees.view | devices.control | ...
  title String
  grp   String
  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  ip         String?
  createdAt  DateTime  @default(now())
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId Int?
  actorName   String?
  action      String // login | login_failed | logout | create | update | delete | approve | reject | device_command | ...
  entity      String // user | employee | device | leave | ...
  entityId    String?
  detail      String?
  ip          String?
  at          DateTime @default(now())
}

// ============ Device Operations (PLAN Phase 2) ============

model DeviceCommand {
  id              String    @id @default(cuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type            String // unlock | sync_time | restart | push_user | delete_user | get_user | refresh_data | clear_data | enable_device | disable_device
  payload         String? // JSON
  status          String    @default("pending") // pending | delivered | acked | failed
  createdByUserId Int?
  createdBy       String?
  result          String?
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?
  ackedAt         DateTime?
}

// ============ Payroll / Corrections / Holidays (PLAN Phase 4) ============

model CorrectionRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         String // "2026-10-18"
  requestedIn  DateTime? // ورود اصلاحی
  requestedOut DateTime? // خروج اصلاحی
  reason       String
  status       String    @default("در انتظار تأیید") // در انتظار تأیید | تأیید شده | رد شده
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  date        String   @unique // "2026-03-21"
  title       String
  jYear       Int // 1404
  jMonth      Int // 1..12
  jDay        Int
  createdAt   DateTime @default(now())
}

model PayrollRun {
  id            String    @id @default(cuid())
  jYear         Int
  jMonth        Int
  status        String    @default("پیش‌نویس") // پیش‌نویس | نهایی
  note          String?
  totalGross    Float     @default(0)
  totalNet      Float     @default(0)
  employeeCount Int       @default(0)
  createdBy     String?
  finalizedAt   DateTime?
  payslips      Payslip[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([jYear, jMonth])
}

model Payslip {
  id           String     @id @default(cuid())
  runId        String
  run          PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  baseSalary   Float      @default(0)
  overtimePay  Float      @default(0)
  allowances   Float      @default(0)
  absentDeduct Float      @default(0)
  insurance    Float      @default(0)
  tax          Float      @default(0)
  netPay       Float      @default(0)
  workedMin    Int        @default(0)
  overtimeMin  Int        @default(0)
  absentDays   Float      @default(0)
  detail       String? // JSON breakdown
  createdAt    DateTime   @default(now())

  @@unique([runId, employeeId])
}
