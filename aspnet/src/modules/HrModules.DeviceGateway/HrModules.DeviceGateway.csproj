<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ============================================================
    HrModules.DeviceGateway (فاز ۶۳) — ماژول دروازهٔ دستگاه‌ها
    ============
    جایگزین درون‌اپیِ سرویس ویندوزی HrDeviceGateway: همان کارکردها
    (poller TCP هر دستگاه، پل ADMS /iclock/cdata، پل دوربین‌های
    پلاک‌خوان /anpr/…، حلقه ضربان/دستورات راهبند و بازبین آفلاین)
    به‌صورت BackgroundService + endpoint درون‌پردازشی داخل خود وب‌اپ —
    بدون HTTP میانی و بدون حساب svc_bridge.

    ارتباط با پلتفرم فقط از طریق Platform.Contracts
    (IDeviceGatewayChannel + IModuleAvailability) — ادامهٔ قانون فاز ۶۱.
    خدمات دوربین‌های پارکینگ هم از IParkingGatewaySink (پیاده‌سازی
    اختیاری در ماژول پارکینگ) گرفته می‌شود.

    بستهٔ مشتری بدون این ماژول:
      dotnet publish -p:HrModuleGateway=false
    در این حالت نه DLL ماژول هست، نه endpointهای /iclock و /anpr —
    و سرویس ویندوزی مستقل همچنان گزینهٔ استقرار جداگانه است.

    متعهد به: Platform.Core (پلتفرم مشترک) — وابستگی یک‌طرفه.
    ============================================================
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>fa</NeutralLanguage>
    <!-- پشتیبانی صریح Razor برای MVC — بدون این، ویوها در اسمبلی کامپایل نمی‌شوند -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform.Contracts\Platform.Contracts.csproj" />
  </ItemGroup>

</Project>
