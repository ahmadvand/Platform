@{
    // فاز ۱۱۲ — هاب داده‌ها؛ فاز ۱۲۲ — جدول به پارتیال مشترک با مرکز /DataTransfer منتقل شد
    // (کاتالوگ اعلامی‌محور: هر ماژول خانواده‌های خودش را اعلام می‌کند — ماژول غایب = هیچ)
    Layout = "_Layout";
    ViewData["Title"] = HrT.T("درون‌ریزی و برون‌بری داده");
    var catalog = (List<Platform.Web.Services.DataExchange.DataEntity>)ViewBag.Catalog;
}
<div class="toast toast-ok" data-toast>
    @HrT.T("برای مهاجرت از نرم‌افزار قبلی: خروجیِ آن نرم‌افزار را در قالب ستون‌های همین سامانه دربیاورید (ساده‌ترین راه: ویرایش خروجی اکسل هر جدول در همین صفحه) و در همین صفحه درون‌ریزی کنید. برای واگذاری داده به نرم‌افزار دیگر هم همین خروجی‌ها را بدهید.")
</div>

