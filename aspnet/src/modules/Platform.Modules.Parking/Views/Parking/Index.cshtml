@{
    ViewData["Title"] = HrT.T("کنترل پارکینگ");
    var tab = (string)ViewBag.Tab;
    var lots = (List<ParkingLot>)ViewBag.Lots;
    var vehicles = (List<Vehicle>)ViewBag.Vehicles;
    var permits = (List<ParkingPermit>)ViewBag.Permits;
    var events = (List<ParkingEvent>)ViewBag.Events;
    var cameras = (List<AnprCamera>)(ViewBag.Cameras ?? new List<AnprCamera>());
    var companies = (List<Company>)(ViewBag.Companies ?? new List<Company>());
    var occ = (Dictionary<string, int>)ViewBag.Occupancy;
    var insideTotal = (int)ViewBag.InsideTotal;
    var todayEvents = (int)ViewBag.TodayEvents;
    var todayAutoReads = (int)ViewBag.TodayAutoReads;
    var resultFilter = (string?)ViewBag.ResultFilter;
    var canManage = Me.Get()!.Has("parking.lots.manage") || Me.Get()!.Has("parking.vehicles.manage") || Me.Get()!.Has("parking.cameras.manage");
    var canControl = Me.Get()!.Has("parking.barrier") || Me.Get()!.Has("parking.scan");
    var curCo = (string?)ViewBag.Co;

    // شمارنده‌های تابلوی زنده
    var totalCap = lots.Where(l => l.Active).Sum(l => l.Capacity);
    var activePermits = permits.Count(p => p.Status == "فعال" && (p.ValidUntil == null || p.ValidUntil >= DateTime.Now));
    var insideNow = lots.Sum(l => occ.GetValueOrDefault(l.Id));
    var onlineCams = cameras.Count(c => c.Active && ParkingOps.IsOnline(c));
    var offlineCams = cameras.Count(c => c.Active) - onlineCams;
}
@* فاز ۱۲۴-د — هدر صفحه مطابق طرح Figma (زیرنویس با دادهٔ واقعی همین صفحه) *@
<div class="page-h">
    <div>
        <h1>@HrT.T("کنترل پارکینگ")</h1>
        <div class="page-sub">@HrT.F("{0} خودرو · {1} مجوز · {2} پارکینگ ثبت‌شده", Jalali.Num(vehicles.Count), Jalali.Num(permits.Count), Jalali.Num(lots.Count))</div>
    </div>
</div>
<div class="chips">
    <form method="get" style="display:inline-flex;gap:6px;align-items:center">
        <input type="hidden" name="tab" value="@tab" />
        <select name="co" onchange="this.form.submit()" style="padding:6px 10px;border-radius:8px;border:1px solid var(--line);font-size:12px">
            <option value="">@HrT.T("همه شرکت‌ها")</option>
            @foreach (var c in companies)
            {
                <option value="@c.Id" selected="@(curCo == c.Id)">@c.Name</option>
            }
        </select>
    </form>
</div>
<div class="tabs">
    <a href="/Parking?tab=live" class="@(tab == "live" ? "on" : "")">@HrT.T("📹 نمای زنده")</a>
    <a href="/Parking?tab=board" class="@(tab == "board" ? "on" : "")">@HrT.T("🅿️ تابلوی پارکینگ")</a>
    <a href="/Parking?tab=cameras" class="@(tab == "cameras" ? "on" : "")">@HrT.T("📷 دوربین‌های پلاک‌خوان") (@Jalali.Num(cameras.Count))</a>
    <a href="/Parking?tab=lots" class="@(tab == "lots" ? "on" : "")">@HrT.T("پارکینگ‌ها و گیت‌ها") (@Jalali.Num(lots.Count))</a>
    <a href="/Parking?tab=vehicles" class="@(tab == "vehicles" ? "on" : "")">@HrT.T("خودروها") (@Jalali.Num(vehicles.Count))</a>
    <a href="/Parking?tab=permits" class="@(tab == "permits" ? "on" : "")">@HrT.T("مجوزها") (@Jalali.Num(permits.Count))</a>
    <a href="/Parking?tab=events" class="@(tab == "events" ? "on" : "")">@HrT.T("رویدادها") (@Jalali.Num(events.Count))</a>
</div>

<div data-refresh-host>
@if (tab == "live")
{
    <div class="kpis">
        <div class="kpi"><div class="v" id="lv-inside">@Jalali.Num(insideNow)</div><div class="l">@HrT.T("خودرو داخل پارکینگ")</div></div>
        <div class="kpi info"><div class="v" id="lv-cap">@Jalali.Num(totalCap)</div><div class="l">@HrT.T("ظرفیت کل")</div></div>
        <div class="kpi warn"><div class="v" id="lv-today">@Jalali.Num(todayEvents)</div><div class="l">@HrT.T("رویداد امروز")</div></div>
        <div class="kpi ok"><div class="v" id="lv-auto">@Jalali.Num(todayAutoReads)</div><div class="l">@HrT.T("خوانش خودکار امروز")</div></div>
        <div class="kpi ok"><div class="v" id="lv-online">@Jalali.Num(onlineCams)<span style="font-size:12px;color:var(--ink-2)"> / @Jalali.Num(cameras.Count(c => c.Active))</span></div><div class="l">@HrT.T("دوربین آنلاین")</div></div>
    </div>

    <div class="live-grid">
        <div class="live-main">
            <div class="card">
                <div class="card-h">
                    <h2>@HrT.T("📹 دیوار دوربین‌های پلاک‌خوان")</h2>
                    <span class="hint">@HrT.T("به‌روزرسانی خودکار هر ۶ ثانیه — خوانش پلاک روی تصویر نمایش داده می‌شود")</span>
                </div>
                <div class="card-b">
                    @if (cameras.Count == 0)
                    {
                        <div class="empty">@HrT.T("هنوز دوربین پلاک‌خوانی ثبت نشده است — از تب «دوربین‌های پلاک‌خوان» اضافه کنید")</div>
                    }
                    <div class="cam-wall" id="camWall">
                        @foreach (var c in cameras)
                        {
                            <div class="cam-tile" data-cam-id="@c.Id">
                                <div class="cam-head">
                                    <strong>@c.Name</strong>
                                    <span class="badge badge-mute" data-role="cam-badge">…</span>
                                </div>
                                <div class="cam-feed" data-role="cam-feed">
                                    <div class="cam-osd">
                                        <span class="rec-dot"></span>
                                        <span data-role="cam-osd">CAM · @c.Brand@(string.IsNullOrEmpty(c.Model) ? "" : " " + c.Model)@(string.IsNullOrEmpty(c.Ip) ? "" : " · " + c.Ip)</span>
                                    </div>
                                    <div class="cam-scan"></div>
                                    <div class="cam-off" data-role="cam-off">@HrT.T("⛔ بدون سیگنال")</div>
                                    <div class="cam-read" data-role="cam-read">
                                        <span data-role="cam-plate">······</span>
                                        <span class="cam-readmeta" data-role="cam-readmeta">@HrT.T("در انتظار اولین خوانش…")</span>
                                    </div>
                                </div>
                                <div class="cam-foot">
                                    <span title="@HrT.T("گیت")">🚧 @(c.Gate?.Name ?? "—")</span>
                                    <span title="@HrT.T("پارکینگ")">🅿️ @(c.Gate?.Lot?.Name ?? "—")</span>
                                    <span title="@HrT.T("جهت لاین")">@(c.Direction == "ورودی" ? HrT.T("⬅ ورودی") : c.Direction == "خروجی" ? HrT.T("خروجی ➡") : HrT.T("⬌ دوطرفه"))</span>
                                    <span class="num" style="font-size:10px" data-role="cam-lastseen">@(c.LastSeenAt is null ? HrT.T("بدون سابقه") : Jalali.FmtLong(c.LastSeenAt.Value))</span>
                                </div>
                                @if (canControl)
                                {
                                    <div class="btn-row">
                                        <form method="post" action="/Parking/SimCameraHeartbeat" class="inline-form" data-ajax data-refresh>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm" title="@HrT.T("شبیه‌سازی اتصال دوربین")">@HrT.T("♻️ اتصال")</button>
                                        </form>
                                        <form method="post" action="/Parking/PingCamera" class="inline-form" data-ajax data-refresh>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm" title="@HrT.T("صف‌کردن دستور ping")">@HrT.T("📶 ضربان")</button>
                                        </form>
                                        <form method="post" action="/Parking/OpenBarrier" class="inline-form" data-ajax data-refresh data-confirm="@HrT.F("دستور بازکردن راهبند «{0}» صف شود؟", c.Gate?.Name)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm btn-ok" title="@HrT.T("بازکردن راهبند از راه دور")">@HrT.T("🔓 راهبند")</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <aside class="live-side">
            <div class="card">
                <div class="card-h"><h2>@HrT.T("🔔 خوانش‌های زنده")</h2><span class="badge badge-ok"><span class="dot dot-on"></span> @HrT.T("زنده")</span></div>
                <div class="ticker" id="ticker">
                    <div class="empty">@HrT.T("در حال اتصال…")</div>
                </div>
            </div>
            <div class="card">
                <div class="card-h"><h2>@HrT.T("🚗 داخل پارکینگ")</h2><span class="hint" id="inside-count">@Jalali.Num(insideNow) @HrT.T("خودرو")</span></div>
                <div class="ticker" id="insideList">
                    <div class="empty">—</div>
                </div>
            </div>
        </aside>
    </div>


}
else if (tab == "board")
{
    <div class="kpis">
        <div class="kpi"><div class="v">@Jalali.Num(insideNow)</div><div class="l">@HrT.T("خودرو داخل پارکینگ")</div></div>
        <div class="kpi info"><div class="v">@Jalali.Num(totalCap)</div><div class="l">@HrT.T("ظرفیت کل پارکینگ‌ها")</div></div>
        <div class="kpi ok"><div class="v">@Jalali.Num(activePermits)</div><div class="l">@HrT.T("مجوز فعال")</div></div>
        <div class="kpi warn"><div class="v">@Jalali.Num(todayEvents)</div><div class="l">@HrT.T("رویداد امروز")</div></div>
        <div class="kpi ok"><div class="v">@Jalali.Num(onlineCams)<span style="font-size:12px;color:var(--ink-2)"> / @Jalali.Num(cameras.Count(c => c.Active))</span></div><div class="l">@HrT.T("📷 دوربین آنلاین")</div></div>
        <div class="kpi @(offlineCams > 0 ? "warn" : "info")"><div class="v">@Jalali.Num(todayAutoReads)</div><div class="l">@HrT.T("خوانش خودکار پلاک امروز")</div></div>
    </div>

    <div class="card">
        <div class="card-h">
            <h2>@HrT.T("اشغال پارکینگ‌ها")</h2>
            @if (canControl)
            {
                <button class="btn btn-primary" data-modal="/Parking/ScanForm" data-modal-title="@HrT.T("شبیه‌ساز پلاک‌خوان — ثبت عبور خودرو")">@HrT.T("📷 ثبت عبور خودرو")</button>
            }
        </div>
        <div class="card-b">
            @if (lots.Count == 0)
            {
                <div style="color:var(--ink-2)">@HrT.T("هنوز پارکینگی ثبت نشده است.")</div>
            }
            @foreach (var lot in lots)
            {
                var used = occ.GetValueOrDefault(lot.Id);
                var pct = lot.Capacity > 0 ? (int)Math.Round(used * 100.0 / lot.Capacity) : 0;
                var tone = pct >= 90 ? "err" : pct >= 70 ? "warn" : "ok";
                <div style="margin-bottom:16px">
                    <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap">
                        <strong style="font-size:13.5px">@lot.Name</strong>
                        <span class="code" style="color:var(--ink-3);font-size:11px">@lot.Code</span>
                        <span class="badge badge-mute" style="font-size:10.5px">🏢 @(lot.Company?.Name ?? "—")</span>
                        @if (!lot.Active)
                        {
                            <span class="badge badge-err">@HrT.T("غیرفعال")</span>
                        }
                        <span class="badge @(tone == "err" ? "badge-err" : tone == "warn" ? "badge-warn" : "badge-ok")">
                            @HrT.F("{0} از {1} جایگاه ({2}٪)", Jalali.Num(used), Jalali.Num(lot.Capacity), Jalali.Num(pct))
                        </span>
                        <span class="badge badge-mute">🚧 @Jalali.Num(lot.Gates.Count) @HrT.T("گیت")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(lot.Location))
                    {
                        <div style="color:var(--ink-2);font-size:11.5px;margin-bottom:6px">📍 @lot.Location</div>
                    }
                    <div style="height:10px;border-radius:6px;background:var(--line);overflow:hidden;max-width:560px">
                        <div style="height:100%;width:@(Math.Clamp(pct, 0, 100))%;border-radius:6px;background:@(tone == "err" ? "var(--err)" : tone == "warn" ? "var(--warn)" : "var(--ok)")"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-h"><h2>@HrT.T("آخرین رویدادهای پارکینگ")</h2><a class="btn btn-sm" href="/Parking?tab=events">@HrT.T("همه رویدادها")</a></div>
        <div class="table-wrap">
            <table class="tbl">
                <thead><tr><th>@HrT.T("زمان")</th><th>@HrT.T("پلاک")</th><th>@HrT.T("صاحب خودرو")</th><th>@HrT.T("گیت")</th><th>@HrT.T("پارکینگ")</th><th>@HrT.T("جهت")</th><th>@HrT.T("نتیجه")</th></tr></thead>
                <tbody>
                    @foreach (var e in events.Take(8))
                    {
                        <tr>
                            <td class="num">@Jalali.FmtLong(e.Timestamp)</td>
                            <td>@PlateFmt.Render(e.PlateText)</td>
                            <td>@(e.Vehicle?.Employee?.FullName ?? "—")</td>
                            <td>@e.Gate?.Name</td>
                            <td>@e.Gate?.Lot?.Name</td>
                            <td>@HrT.T(e.Direction)</td>
                            <td>
                                <span class="badge @(e.Result == "مجاز" ? "badge-ok" : "badge-err")">@HrT.T(e.Result)</span>
                                @(e.Reason == null ? "" : $" — {e.Reason}")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (tab == "cameras")
{
    var pendingCmds = (List<AnprCommand>)(ViewBag.PendingCmds ?? new List<AnprCommand>());
    <div class="kpis">
        <div class="kpi ok"><div class="v">@Jalali.Num(onlineCams)</div><div class="l">@HrT.T("دوربین آنلاین")</div></div>
        <div class="kpi @(offlineCams > 0 ? "err" : "info")"><div class="v">@Jalali.Num(offlineCams)</div><div class="l">@HrT.T("آفلاین")</div></div>
        <div class="kpi info"><div class="v">@Jalali.Num(cameras.Count(c => c.Active))</div><div class="l">@HrT.T("دوربین فعال")</div></div>
        <div class="kpi warn"><div class="v">@Jalali.Num(cameras.Sum(c => c.Events.Count(e => e.Timestamp >= DateTime.Now.Date)))</div><div class="l">@HrT.T("خوانش امروز دوربین‌ها")</div></div>
    </div>

    <div class="card">
        <div class="card-h">
            <h2>@HrT.T("دوربین‌های پلاک‌خوان") (ANPR)</h2>
            @if (canManage)
            {
                <button class="btn btn-primary" data-modal="/Parking/CreateCamera" data-modal-title="@HrT.T("دوربین پلاک‌خوان جدید")">@HrT.T("📷 + دوربین")</button>
            }
        </div>
        <div class="hint" style="padding:0 14px">
            @HrT.T("دوربین‌ها همانند دستگاه‌های تردد با") <b>SN</b> @HrT.T("و") <b>@HrT.T("توکن webhook")</b> @HrT.T("به پل وصل می‌شوند:")
            @HrT.T("هر پلاک خوانده‌شده را به") <code dir="ltr">POST /api/anpr/webhook</code> (@HrT.T("رویداد") <code dir="ltr">plate</code>)
            @HrT.T("بفرستند؛ موتور مجوز به‌طور") <b>@HrT.T("خودکار")</b> @HrT.T("ورود/خروج را ثبت و در صورت مجاز بودن راهبند را باز می‌کند.")
        </div>
        <div class="table-wrap">
            <table class="tbl">
                <thead><tr><th>@HrT.T("دوربین")</th><th>SN</th><th>@HrT.T("گیت / پارکینگ")</th><th>@HrT.T("جهت")</th><th>@HrT.T("آستانه اطمینان")</th><th>@HrT.T("وضعیت")</th><th>@HrT.T("آخرین اتصال")</th><th>@HrT.T("خوانش امروز")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in cameras)
                    {
                        var online = ParkingOps.IsOnline(c);
                        var todayCount = c.Events.Count(e => e.Timestamp >= DateTime.Now.Date);
                        <tr>
                            <td>
                                <strong>@c.Name</strong>
                                <div style="font-size:11px;color:var(--ink-2)">@c.Brand @(string.IsNullOrEmpty(c.Model) ? "" : c.Model) @(string.IsNullOrEmpty(c.Ip) ? "" : "· " + c.Ip)</div>
                                @if (!string.IsNullOrEmpty(c.StreamUrl))
                                {
                                    <div style="font-size:10px;color:var(--ink-3)" dir="ltr">@c.StreamUrl</div>
                                }
                            </td>
                            <td><code dir="ltr" style="font-size:10.5px">@c.Serial</code></td>
                            <td>@(c.Gate?.Name ?? "—")<div style="font-size:11px;color:var(--ink-2)">@(c.Gate?.Lot?.Name ?? "—") @(c.Company != null ? "· " + c.Company.Code : "")</div></td>
                            <td>@HrT.T(c.Direction)</td>
                            <td>@Jalali.Num(c.ConfidenceThreshold)٪</td>
                            <td>
                                @if (!c.Active)
                                {
                                    <span class="badge badge-mute">@HrT.T("غیرفعال")</span>
                                }
                                else if (online)
                                {
                                    <span class="badge badge-ok">@HrT.T("🟢 آنلاین")</span>
                                }
                                else
                                {
                                    <span class="badge badge-err">@HrT.T("🔴 آفلاین")</span>
                                }
                            </td>
                            <td class="num" style="font-size:11px">@(c.LastSeenAt is null ? HrT.T("بدون سابقه") : Jalali.FmtLong(c.LastSeenAt.Value))</td>
                            <td class="num">@Jalali.Num(todayCount)</td>
                            <td>
                                <div class="btn-row">
                                    @if (canControl)
                                    {
                                        <form method="post" action="/Parking/PingCamera" class="inline-form" data-ajax data-refresh>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm" title="@HrT.T("صف‌کردن دستور ping")">@HrT.T("📶 ضربان")</button>
                                        </form>
                                        <form method="post" action="/Parking/SimCameraHeartbeat" class="inline-form" data-ajax data-refresh>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm" title="@HrT.T("شبیه‌سازی اتصال (دمو)")">@HrT.T("♻️ آنلاین")</button>
                                        </form>
                                        <form method="post" action="/Parking/OpenBarrier" class="inline-form" data-ajax data-refresh data-confirm="@HrT.F("دستور بازکردن راهبند «{0}» برای این دوربین صف شود؟", c.Gate?.Name)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm btn-ok" title="@HrT.T("دستور بازکردن راهبند از راه دور")">@HrT.T("🔓 راهبند")</button>
                                        </form>
                                    }
                                    @if (canManage)
                                    {
                                        <form method="post" action="/Parking/ToggleCamera" class="inline-form" data-ajax data-refresh>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm">@(c.Active ? HrT.T("غیرفعال") : HrT.T("فعال"))</button>
                                        </form>
                                        <form method="post" action="/Parking/RotateCameraToken" class="inline-form" data-ajax data-refresh data-confirm="@HrT.F("توکن اتصال «{0}» چرخش شود؟ توکن قبلی باطل می‌شود.", c.Name)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm" title="@HrT.T("چرخش توکن webhook")">🔑</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (cameras.Count == 0)
            {
                <div style="padding:14px;color:var(--ink-2)">@HrT.T("هنوز دوربین پلاک‌خوانی ثبت نشده است.")</div>
            }
        </div>
    </div>

    @if (pendingCmds.Count > 0)
    {
        <div class="card">
            <div class="card-h"><h2>@HrT.T("دستورات صف‌شده دوربین‌ها")</h2><span class="hint">@HrT.T("در اولین اتصال دوربین") (GET api/anpr/webhook) @HrT.T("تحویل می‌گیرند")</span></div>
            <div class="table-wrap">
                <table class="tbl">
                    <thead><tr><th>@HrT.T("دوربین")</th><th>@HrT.T("دستور")</th><th>@HrT.T("وضعیت")</th><th>@HrT.T("ثبت‌کننده")</th><th>@HrT.T("زمان")</th></tr></thead>
