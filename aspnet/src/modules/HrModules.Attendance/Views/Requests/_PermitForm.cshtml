@{
    // فاز ۱۱۴ — انتخاب پرسنل با جستجوی زندهٔ سرور (emp-picker) — مقیاس ده‌ها هزار نفر
}
<div data-modal-title="@HrT.T("مجوز جدید (اضافه‌کاری / کار در تعطیل)")" hidden></div>
<form method="post" action="/Requests/CreatePermit" data-ajax data-refresh>
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="fld"><label>@HrT.T("پرسنل *")</label>
            <div class="emp-picker" data-name="employeeId" data-min="1"
                 data-ph="@HrT.T("جستجوی نام یا کد پرسنلی…")" data-empty="@HrT.T("موردی یافت نشد")"></div>
        </div>
        <div class="fld"><label>@HrT.T("نوع")</label>
            <select name="type"><option value="اضافه‌کاری">@HrT.T("اضافه‌کاری")</option><option value="کار در تعطیل">@HrT.T("کار در تعطیل")</option><option value="خروج غیرمجاز">@HrT.T("خروج غیرمجاز")</option></select>
        </div>
        <div class="fld"><label>@HrT.T("تاریخ *")</label><input name="date" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="fld"><label>@HrT.T("از ساعت *")</label><input name="fromTime" type="time" required value="16:00" /></div>
        <div class="fld"><label>@HrT.T("تا ساعت *")</label><input name="toTime" type="time" required value="19:00" /></div>
        <div class="fld fld-full"><label>@HrT.T("دلیل")</label><input name="reason" /></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px">
        <button class="btn btn-primary">@HrT.T("ثبت مجوز")</button>
        <button type="button" class="btn" data-close-modal>@HrT.T("انصراف")</button>
    </div>
</form>
