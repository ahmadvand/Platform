@inject Platform.Web.Services.ICurrentUser Me
@{
    ViewData["Title"] = HrT.T("هشدار مجوز نصب");
    var info = (Platform.Web.Services.LicenseSnapshot)ViewBag.Info;
    var machineId = (string)ViewBag.MachineId;
    var mode = (string)ViewBag.Mode;
    var hardLock = (bool)ViewBag.HardLock;   // فاز ۷۸ — قفل سخت درج‌شده در مجوز
    var sess = Me.Get();
    var isSuper = sess?.IsSuperadmin ?? false;
}
@* فاز ۵۱ — صفحهٔ هشدار مجوز (به‌جای قطع سرویس): کاربر تایید می‌کند و ادامه می‌دهد *@
<div class="lic-wrap">
    <div class="lic-card">
        <div class="lic-head">
            <div class="lic-logo">@(hardLock ? "🔒" : "⚠️")</div>
            <div>
                <h1>@(hardLock ? HrT.T("قفل سخت — مجوز نصب سامانه") : HrT.T("هشدار — مجوز نصب سامانه"))</h1>
                <p>@(hardLock
                    ? HrT.T("این مجوز با «حالت اجرای قفل سخت» صادر شده است؛ تا ورود مجوز معتبر، صفحه‌های سامانه بسته می‌مانند.")
                    : HrT.T("سامانه فعال است، اما وضعیت مجوز نیاز به توجه مدیر دارد. پس از مطالعه، هشدار را تایید و ادامه دهید."))</p>
            </div>
        </div>
        <div class="lic-body">
            <div class="lic-state err">
                <span>🔒</span>
                <span>@info.Message</span>
            </div>

            <div class="lic-rows">
                <div class="lic-row"><span class="k">@HrT.T("حالت مجوز")</span><span class="v">@(hardLock ? HrT.T("قفل سخت — طبق مجوز (lock)") : mode == "Strict" ? HrT.T("فقط هشدار (Strict)") : mode)</span></div>
                <div class="lic-row"><span class="k">@HrT.T("دارندهٔ مجوز")</span><span class="v">@(info.Licensee ?? "—")</span></div>
                <div class="lic-row"><span class="k">@HrT.T("اعتبار تا")</span><span class="v">@(info.ExpiresAtUtc is { } e ? Jalali.ToPersianDigits(Jalali.FmtFa(e.ToLocalTime())) : "—")</span></div>
                <div class="lic-row">
                    <span class="k">@HrT.T("امضای سرور")</span>
                    <span class="v lic-fp">
                        <code>@machineId</code>
                    </span>
                </div>
            </div>

            @if (!hardLock)
            {
                <p class="hint" style="font-size:12px;line-height:2.1;margin:0 0 16px">
                    @HrT.T("کارکرد سامانه قطع نشده است — همهٔ بخش‌ها و دستگاه‌ها همچنان فعال‌اند؛ اما برای رفع این هشدار، مجوز جدید را در صفحهٔ «مجوز نصب» وارد کنید. فایل درخواست (.hrreq) را از همان صفحه دانلود و برای صدور مجوز ارسال کنید. تا آن زمان، این هشدار پس از هر ورود به سامانه نمایش داده می‌شود.")
                </p>

                <form method="post" action="/License/Ack" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary" style="min-width:170px">✓ @HrT.T("فهمیدم — ادامه به سامانه")</button>
                    @if (isSuper)
                    {
                        <a class="btn" href="/License">@HrT.T("مدیریت مجوز نصب ←")</a>
                    }
                </form>
            }
            else
            {
                <p class="hint" style="font-size:12px;line-height:2.1;margin:0 0 16px">
                    @HrT.T("این مجوز با «حالت اجرای قفل سخت» (lock) صادر شده است — تا ورود مجوز معتبر، صفحه‌های سامانه در دسترس نیستند (API و پل دستگاه‌ها برای سلامت داده‌ها باز می‌مانند). لطفاً مجوز جدید را در صفحهٔ «مجوز نصب» وارد کنید: فایل درخواست (.hrreq) را از همان صفحه دانلود و برای صدور مجوز جدید به تولیدکننده ارسال کنید.")
                </p>

                @if (isSuper)
                {
                    <a class="btn btn-primary" href="/License">@HrT.T("مدیریت مجوز نصب ←")</a>
                }
            }
        </div>
    </div>
</div>

<style>
    /* بازاستفاده از استایل صفحهٔ مجوز — کلاس‌ها همان lic-* صفحهٔ /License است؛
       برای استقلال کامل صفحهٔ هشدار در حالت بدون پوسته، همان بلوک اینجا تکرار شده است */
    .lic-wrap { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 26px 16px; }
    .lic-card { width: 100%; max-width: 720px; background: var(--surface, #fff); border: 1px solid var(--line, #e3e6f0);
        border-radius: 20px; box-shadow: 0 24px 70px rgba(23,32,90,.12); overflow: hidden; }
    .lic-head { padding: 24px 28px 18px; border-bottom: 1px solid var(--line, #e3e6f0); display: flex; gap: 14px; align-items: center; }
    .lic-logo { width: 50px; height: 50px; border-radius: 15px; background: var(--grad-btn, linear-gradient(135deg,#6366f1,#4f46e5));
        display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24px; flex: none; }
    .lic-head h1 { font-size: 17.5px; margin: 0 0 3px; }
    .lic-head p { margin: 0; color: var(--ink-2, #667); font-size: 12.5px; line-height: 1.9; }
    .lic-body { padding: 22px 28px 28px; }
    .lic-state { display: flex; align-items: center; gap: 10px; border-radius: 13px; padding: 12px 15px; font-size: 13px; font-weight: 700;
        border: 1px solid; margin-bottom: 16px; flex-wrap: wrap; }
    .lic-state.err { background: rgba(225,29,72,.07); border-color: rgba(225,29,72,.3); color: #9f1239; }
    .lic-rows { display: grid; gap: 9px; margin-bottom: 18px; }
    .lic-row { display: flex; justify-content: space-between; gap: 14px; border: 1px dashed var(--line, #e3e6f0);
        border-radius: 11px; padding: 9px 13px; font-size: 12.5px; align-items: center; }
    .lic-row .k { color: var(--ink-3, #889); flex: none; }
    .lic-row .v { color: var(--ink, #223); font-weight: 600; text-align: left; word-break: break-word; }
    .lic-fp code { font-family: Consolas, monospace; font-size: 13px; letter-spacing: .06em; direction: ltr; }
</style>
