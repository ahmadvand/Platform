<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ============================================================
       HrDeviceGateway — سرویس ویندوزی مدیریت دستگاه‌های تردد
       ASP.NET Core 8 (Kestrel + Worker Service + UseWindowsService)
       وظایف:
         1) پل ADMS/PUSH (دستگاه‌های ZKTeco به این سرویس Push می‌کنند)
         2) کلاینت TCP باینری ZKTeco (پورت 4370) برای دستگاه‌های بدون ADMS
         3) اجرای دستورات صف‌شده سرور: unlock / sync_time / restart /
            push_user / delete_user / refresh_data / get_users / clear_data
         4) خواندن رکوردهای تردد و کاربران از دستگاه و ارسال به سرور مرکزی
       ============================================================ -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HrDeviceGateway</RootNamespace>
    <AssemblyName>HrDeviceGateway</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

</Project>
